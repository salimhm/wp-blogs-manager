# .env.example
# Copy this file to .env and fill in your actual values

# Django Settings
SECRET_KEY='SECRET_KEY'
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,152.53.169.25

# Database (used by Docker Compose)
POSTGRES_DB=wordpress_ai_publisher
POSTGRES_USER=wp_ai_publisher_user
POSTGRES_PASSWORD=dbpassword
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Shared cache and Groq quota scheduler
DJANGO_CACHE_URL=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=8
GROQ_DEFAULT_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_ARTICLE_MAX_TOKENS=4400
GROQ_EXPECTED_ARTICLE_TOKENS=3000
GROQ_TOKEN_SAFETY_RATIO=0.90
GROQ_DAILY_SAFETY_RATIO=0.90
GROQ_MIN_COMPLETION_TOKENS=1800

# CloudPanel one-click WordPress provisioning
CLOUDPANEL_ORIGIN_IP=152.53.53.101
CLOUDPANEL_SSH_HOST=152.53.53.101
CLOUDPANEL_SSH_PORT=22
CLOUDPANEL_SSH_USER=wp-provisioner
CLOUDPANEL_SSH_KEY_PATH=/run/secrets/cloudpanel/id_ed25519
CLOUDPANEL_KNOWN_HOSTS_PATH=/run/secrets/cloudpanel/known_hosts
CLOUDPANEL_WRAPPER_COMMAND=sudo -n /usr/local/sbin/wp-manager-cloudpanel
CLOUDPANEL_PROVISION_TIMEOUT=900
CLOUDPANEL_PHP_VERSION=8.3
CLOUDPANEL_VHOST_TEMPLATE=WordPress
CLOUDPANEL_DOCUMENT_ROOT_TEMPLATE=/home/{site_user}/htdocs/{domain}
CLOUDPANEL_ADMIN_EMAIL=admin@example.com
PROVISIONING_ENCRYPTION_KEY=

# AI API Keys
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here